import cv2
import numpy as np
width, height = 512, 512
fps = 30  
duration = 5 
fourcc = cv2.VideoWriter_fourcc(*'XVID')
VideoWriter
out = cv2.VideoWriter('red_video.avi', fourcc, fps, (width, height))
for _ in range(fps * duration):
    frame = np.zeros((height, width, 3), dtype=np.uint8)  
    frame[:] = [0, 0, 255]  
    out.write(frame)
out.release()
cv2.destroyAllWindows()
